{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      "mobile-app/**",
      "dist/**",
      "docs/**"
    ],
    "overrides": [
      {
        "files": [
          "src/plugins/intent-canvas/**"
        ],
        "rules": [
          "react-doctor/no-adjust-state-on-prop-change",
          "react-doctor/async-await-in-loop",
          "react-doctor/no-set-state-after-await-in-effect",
          "react-doctor/prefer-html-dialog",
          "react-doctor/no-pass-data-to-parent"
        ]
      },
      {
        "files": [
          "src/plugins/cli-shared/mcpFormat.ts"
        ],
        "rules": [
          "react-doctor/async-await-in-loop"
        ]
      },
      {
        "files": [
          "src/plugins/git/views/remoteDialogs/PullDialog.tsx"
        ],
        "rules": [
          "react-doctor/exhaustive-deps"
        ]
      },
      {
        "files": [
          "src/plugins/composer/view/CommandDrawer.tsx"
        ],
        "rules": [
          "react-doctor/no-adjust-state-on-prop-change"
        ]
      },
      {
        "files": [
          "src/plugins/git/hooks/useRepoChips.ts"
        ],
        "rules": [
          "react-doctor/no-pass-data-to-parent"
        ]
      },
      {
        "files": [
          "src/plugins/cli-shared/sessionHead.ts"
        ],
        "rules": [
          "react-doctor/async-await-in-loop"
        ]
      }
    ]
  }
}
