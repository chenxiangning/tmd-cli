{
  // react-doctor 配置:
  // - dist/** 产物中命中 artifact-secret-leak 的是 ssh 插件受控表单绑定(`password: e.target.value`/`privateKey: e.target.value`),
  //   非字面量密钥(SSH 协议字段名无法改名重命名会破坏 IPC 契约)。证据:源码 src/plugins/ssh/** 中所有 password/privateKey 出现
  //   位置皆为表单/连接参数对象字段,无任何 secret 字面量。此条为误报,带证据豁免。
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": ["docs/**"],
    "overrides": [
      {
        "files": ["dist/**"],
        "rules": ["react-doctor/artifact-secret-leak"]
      }
    ]
  }
}
