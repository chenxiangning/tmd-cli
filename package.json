{
  "name": "tmd-cli",
  "version": "0.1.6",
  "description": "Plugin-based multi-CLI desktop client. Raw terminal canvas + rich composer.",
  "author": "Chen Xiangning",
  "homepage": "https://github.com/chenxiangning/tmd-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxiangning/tmd-cli.git"
  },
  "bugs": {
    "url": "https://github.com/chenxiangning/tmd-cli/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prune-katex-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:arch-boundary": "node scripts/check-arch-boundary.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:mac-arm64": "node scripts/build-mac.mjs aarch64-apple-darwin",
    "release:mac-local": "zsh scripts/release-mac-local.sh",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "katex": "^0.18.7",
    "mammoth": "^1.12.2",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^5.7.284",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.4",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "viewerjs": "^1.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.9.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.5.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.15.1"
}
